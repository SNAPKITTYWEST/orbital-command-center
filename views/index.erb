<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>MINIKRAN · Orbital command</title><link rel="stylesheet" href="/public/style.css"></head><body>
<header><div class="brand"><span class="logo">◎</span><div>ORBITAL VIEW<small>MINIKRAN / COMMAND CENTER</small></div></div><nav><button class="active" id="home">SOLAR SYSTEM</button><button id="top">TOP DOWN</button><button id="export">EXPORT TELEMETRY ↗</button></nav><div class="live"><i></i> LOCAL SIMULATION <time id="clock"></time></div></header>
<main><aside class="left panel"><div class="eyebrow">CELESTIAL DIRECTORY <span>08</span></div><h2>Solar system</h2><div id="bodies"><% BODIES.each do |body| %><button class="body" data-name="<%= body[:name] %>"><i style="background:<%= body[:color] %>"></i><%= body[:name] %><span>↗</span></button><% end %></div><div class="divider"></div><div class="eyebrow">DISPLAY LAYERS</div><% ['Orbits', 'Labels', 'Asteroid belt', 'Grid'].each do |layer| %><label><input type="checkbox" data-layer="<%= layer %>" checked><%= layer %></label><% end %><div class="notice"><i></i> VISUALIZATION ONLINE<p>Idealized circular orbits.<br>Distances visually compressed.</p></div></aside>
<section class="viewport"><canvas id="space" aria-label="Interactive two-dimensional solar system"></canvas><div class="scene-title"><span class="eyebrow">HELIOCENTRIC / 2D</span><h1>The solar neighborhood</h1><p>Select a world. Follow its orbit.</p></div><div class="zoom"><button id="in" aria-label="Zoom in">+</button><button id="out" aria-label="Zoom out">−</button><button id="reset" aria-label="Reset view">⌖</button></div><div class="scene-footer"><span>◈ SOL CENTERED</span><span id="days">T + 0.00 DAYS</span><span>SCHEMATIC VIEW</span></div></section>
<aside class="right"><section class="panel target"><div class="eyebrow">SELECTED TARGET <span>01</span></div><div id="planet-icon"></div><h2 id="name">Earth</h2><p class="subtitle">PLANET / SOL SYSTEM</p><dl id="facts"></dl><button class="primary" id="focus">⌖ FOCUS TARGET</button><button id="track">◎ TRACK ORBIT</button></section><section class="panel signal"><div class="eyebrow">MISSION STATUS</div><h3><i></i> Simulation nominal</h3><div class="wave">▁▂▁▃▅▂▁▂▆▇▃▂▁▂▃▅▂▁▃▆▂▁</div><p>Ruby control surface<br>Local visualization session</p><div class="status-line"><span>Kernel connection</span><b>OFFLINE</b></div></section></aside></main>
<footer><section><div class="eyebrow">TEMPORAL CONTROL</div><div class="controls"><button id="pause">Ⅱ PAUSE</button><select id="speed" aria-label="Simulation speed"><option value="0.25">0.25 days / second</option><option value="5" selected>5 days / second</option><option value="30">30 days / second</option><option value="365">365 days / second</option></select></div></section><section><div class="eyebrow">ORBITAL POSITION · AU</div><div class="coordinates"><span>X <b id="x">0.000</b></span><span>Y <b id="y">0.000</b></span><span>Z <b>0.000</b></span></div></section><section class="footer-end"><div class="eyebrow">FLIGHT RECORDER</div><p id="event">Session initialized · Earth selected</p></section></footer>
<script id="data" type="application/json"><%= JSON.generate(BODIES) %></script><script src="/public/app.js"></script></body></html>
